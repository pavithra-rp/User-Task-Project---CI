<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="gunicorn"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="/opt/python/3/bin/gunicorn -k uvicorn.workers.UvicornWorker application:app"
           resourceType="Unspecified" />
    </handlers>
  </system.webServer>
</configuration>